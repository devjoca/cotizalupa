# Copy to api/.env and fill in sandbox credentials for local testing.
# Root pnpm API commands load api/.env. The deployed binary uses Railway variables.
PORT=3001
PUBLIC_APP_URL=http://localhost:3002
DATABASE_URL=postgres://cotizalupa:cotizalupa@127.0.0.1:55432/cotizalupa?sslmode=disable

# Local Compose bucket only. Replace all values with Railway bucket settings on deploy.
AWS_S3_BUCKET_NAME=cotizalupa
AWS_ENDPOINT_URL=http://127.0.0.1:59000
AWS_ACCESS_KEY_ID=cotizalupa-local
AWS_SECRET_ACCESS_KEY=cotizalupa-local-secret
AWS_DEFAULT_REGION=us-east-1

POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# CAPI only. Leave both empty in local tests; configure both before running ads.
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Local synthetic reports, without model calls. Railway ignores AI_STUB.
AI_STUB=1
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-6.1-sol

RESEND_API_KEY=
# Set a sender address on a verified Resend domain.
RESEND_FROM=
# Generate once with openssl rand -hex 32. Keep it stable and private.
REPORT_TOKEN_SECRET=

REVIEWS_DISABLED=false
# Optional operational error reporting.
SENTRY_DSN=
