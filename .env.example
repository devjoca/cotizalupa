# Copy to .env for local dev. Never commit .env (see AGENTS.md rule 2).
# Keys return progressively as slices land (DB, bucket, payments) — nothing
# here that the current code does not read.
OPENAI_API_KEY=
# Analysis model. Defaults to gpt-6-astra in code; set only to pin another ID.
OPENAI_ANALYSIS_MODEL=
# Local dev without spending: set to 1 to return a fixed valid analysis
# without calling OpenAI (no key, no network). Leave blank for real analysis.
AI_STUB=
# Local Docker PostgreSQL. Use a separate Neon dev branch when testing remotely.
DATABASE_URL=postgresql://cotizalupa:cotizalupa@127.0.0.1:55432/cotizalupa
# Tests refuse any database not named cotizalupa_test.
TEST_DATABASE_URL=postgresql://cotizalupa:cotizalupa@127.0.0.1:55432/cotizalupa_test
# Server-only error reporting. Leave blank to disable locally.
SENTRY_DSN=
# Local MinIO defaults. Replace with Railway private bucket values when deployed.
AWS_ENDPOINT_URL=http://127.0.0.1:59000
AWS_ACCESS_KEY_ID=cotizalupa-local
AWS_SECRET_ACCESS_KEY=cotizalupa-local-secret
AWS_S3_BUCKET_NAME=cotizalupa
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=path
